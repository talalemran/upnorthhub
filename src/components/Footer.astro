---
/**
 * Footer.astro
 * Multi-column editorial magazine footer with category links,
 * about, and newsletter callout (UI only — hook up to your ESP).
 */
import { SITE } from '../lib/site';
import { CATEGORY_LABELS, CATEGORY_ORDER } from '../lib/posts';
---

<footer class="mt-20 border-t border-zinc-200 bg-zinc-50 lg:mt-28 dark:border-zinc-800 dark:bg-zinc-950">
  <div class="container-editorial grid grid-cols-1 gap-10 py-14 md:grid-cols-3">
    <!-- Brand + about -->
    <div>
      <a href="/" class="flex items-center gap-2" aria-label={`${SITE.name} home`}>
        <span class="flex h-8 w-8 items-center justify-center rounded-sm bg-accent text-zinc-950">
          <span class="font-serif text-lg font-black leading-none">U</span>
        </span>
        <span class="font-serif text-xl font-black tracking-tight text-zinc-900 dark:text-white">{SITE.name}</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-zinc-600 dark:text-zinc-200">
        {SITE.description}
      </p>
    </div>

    <!-- Categories -->
    <div>
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">Sections</h2>
      <ul class="mt-4 space-y-2">
        {
          CATEGORY_ORDER.map((c) => (
            <li>
              <a
                href={`/category/${c}`}
                class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white"
              >
                {CATEGORY_LABELS[c]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Our Site -->
    <div>
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500">Our Site</h2>
       <ul class="mt-4 space-y-2">
        <li><a href="/about" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">About</a></li>
        <li><a href="/contact" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">Contact</a></li>
        <li><a href="/search" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">Search</a></li>
        <li><a href="/tags" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">All Tags</a></li>
        <li><a href="/rss.xml" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">RSS Feed</a></li>
        <li><a href="/sitemap" class="link-underline text-sm text-zinc-700 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">Sitemap</a></li>
      </ul>
    </div>


  </div>

  <!-- Bottom bar -->
    <div class="border-t border-zinc-200 dark:border-zinc-800">
      <div
        class="container-editorial flex flex-col items-center justify-between gap-3 py-6 text-sm text-zinc-500 dark:text-white sm:flex-row"
      >
      <p>© {new Date().getUTCFullYear()} <a href="/" class="link-underline hover:text-accent">{SITE.name}</a>. All rights reserved.</p>
      <p>Built with Astro · Tailwind CSS · TypeScript</p>
    </div>
  </div>
</footer>
