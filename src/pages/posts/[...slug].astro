---
/**
 * posts/[...slug].astro — Article view.
 *  - Clean prose reading experience (typography plugin, dark inverted).
 *  - Auto-generated Table of Contents with smooth scroll.
 *  - Article header: title, UTC-safe date, author card, reading time, badge.
 *  - Right sidebar: author bio, TOC, related articles.
 *  - JSON-LD Article + BreadcrumbList (via BaseLayout/SEO).
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Ad from '../../components/Ad.astro';
import { CATEGORY_LABELS, getReadingTime, formatDate, authorSlug } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, description, pubDate, updatedDate, author, category, tags, coverImage, coverImageAlt, featured } =
  post.data;
const readingTime = getReadingTime(post.body);
const href = `/posts/${post.slug}/`;
const canonical = new URL(href, Astro.site ?? Astro.url).toString();

// Share targets — each opens in a new tab.
const encUrl = encodeURIComponent(canonical);
const encTitle = encodeURIComponent(title);
const shareLinks = [
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${encUrl}&text=${encTitle}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encUrl}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}` },
  { label: 'Reddit', href: `https://www.reddit.com/submit?url=${encUrl}&title=${encTitle}` },
  { label: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${encTitle}%20${encUrl}` },
  { label: 'Telegram', href: `https://t.me/share/url?url=${encUrl}&text=${encTitle}` },
  { label: 'Pinterest', href: `https://pinterest.com/pin/create/button/?url=${encUrl}&description=${encTitle}` },
  { label: 'Email', href: `mailto:?subject=${encTitle}&body=${encUrl}` },
];

// Build TOC (h2 + h3 only), filtering out any generated "Table of Contents".
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Related: same category first, then by recency, excluding current.
const all = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const related = all
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const aCat = a.data.category === category ? 0 : 1;
    const bCat = b.data.category === category ? 0 : 1;
    return aCat - bCat;
  })
  .slice(0, 3);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: CATEGORY_LABELS[category], url: `/category/${category}` },
  { name: title, url: href },
];
---

<BaseLayout
  title={title}
  description={description}
  image={coverImage}
  type="article"
  canonical={canonical}
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={author.name}
  category={CATEGORY_LABELS[category]}
  tags={tags}
  breadcrumbs={breadcrumbs}
>
  <article class="container-editorial py-10 lg:py-14">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-xs text-zinc-500" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span class="text-zinc-500 dark:text-zinc-300">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-zinc-600 dark:text-zinc-200" aria-current="page">{b.name}</span>
            ) : (
              <a href={b.url} class="link-underline hover:text-accent dark:text-zinc-200">{b.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px]">
      <!-- MAIN COLUMN -->
      <div class="min-w-0">
        <!-- Header -->
        <header>
          <div class="flex flex-wrap items-center gap-3">
            <a href={`/category/${category}`} class="badge badge-accent">{CATEGORY_LABELS[category]}</a>
            {featured && <span class="badge">Featured</span>}
            {tags.slice(0, 3).map((t) => <a href={`/tags/${encodeURIComponent(t.toLowerCase())}`} class="badge">#{t}</a>)}
          </div>

          <h1 class="mt-5 font-serif text-4xl font-black leading-[1.05] text-zinc-900 text-balance dark:text-white sm:text-5xl">
            {title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-zinc-600 text-pretty dark:text-zinc-200">{description}</p>

          <!-- Author + meta -->
          <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-y border-zinc-200 py-4 dark:border-zinc-800">
            <div class="flex items-center gap-3">
              <img src={author.avatar} alt={author.name} class="h-12 w-12 rounded-full border border-zinc-300 object-cover dark:border-zinc-700" />
              <div>
                <p class="font-medium text-zinc-900 dark:text-zinc-100">{author.name}</p>
                <p class="text-xs text-zinc-500 dark:text-white">{author.role}</p>
              </div>
            </div>
            <div class="text-right text-xs text-zinc-500 dark:text-zinc-300">
              <p>
                Published <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
                {updatedDate && <span> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
              </p>
              <p class="mt-1">{readingTime} min read</p>
            </div>
          </div>
        </header>

        <!-- Cover -->
        {
          coverImage && (
            <img
              src={coverImage}
              alt={coverImageAlt ?? title}
              class="mt-8 w-full rounded-xl border border-zinc-200 object-cover dark:border-zinc-800"
            />
          )
        }

        <!-- Article body -->
        <div class="prose max-w-none mt-10 prose-p:text-lg prose-li:text-lg prose-headings:font-serif prose-headings:font-bold prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-zinc-800 prose-code:text-accent prose-code:bg-zinc-900 prose-code:px-1 prose-code:rounded prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800 dark:prose-invert">
          <Content />
        </div>

        <!-- Tags footer -->
        <footer class="mt-12 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-300">Tagged:</span>
            {tags.map((t) => <a href={`/tags/${encodeURIComponent(t.toLowerCase())}`} class="badge">#{t}</a>)}
          </div>

          <!-- Share -->
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-300">Share:</span>
            {
              shareLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="inline-flex items-center rounded-full border border-zinc-300 px-3 py-1.5 text-xs font-medium text-zinc-700 transition-colors hover:!border-accent hover:!text-accent dark:border-zinc-700 dark:text-zinc-300"
                  aria-label={`Share on ${s.label}`}
                >
                  {s.label}
                </a>
              ))
            }
            <button
              type="button"
              data-copy-link={canonical}
              class="inline-flex items-center rounded-full border border-zinc-300 px-3 py-1.5 text-xs font-medium text-zinc-700 transition-colors hover:!border-accent hover:!text-accent dark:border-zinc-700 dark:text-zinc-300"
              aria-label="Copy link"
            >
              Copy link
            </button>
          </div>
        </footer>
      </div>

      <!-- SIDEBAR -->
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="space-y-6">
          <!-- Sponsored -->
          <Ad />

          <!-- TOC -->
          {
            toc.length > 0 && (
              <nav class="rounded-xl border border-zinc-200 bg-zinc-100 p-5 dark:border-zinc-800 dark:bg-zinc-900/30" aria-label="Table of contents">
                <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Contents</h2>
                <ul class="mt-3 space-y-2 text-sm">
                  {toc.map((h) => (
                    <li class:list={[h.depth === 3 && 'pl-4']}>
                      <a
                        href={`#${h.slug}`}
                        class="link-underline text-zinc-600 hover:text-zinc-900 dark:text-zinc-200 dark:hover:text-white"
                        data-toc-link={h.slug}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <!-- Author bio -->
          <div class="rounded-xl border border-zinc-200 bg-zinc-100 p-5 dark:border-zinc-800 dark:bg-zinc-900/30">
            <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Written by</h2>
            <div class="mt-3 flex items-center gap-3">
              <img src={author.avatar} alt={author.name} class="h-12 w-12 rounded-full border border-zinc-300 object-cover dark:border-zinc-700" />
              <div>
                <a
                  href={`/author/${authorSlug(author.name)}`}
                  class="link-underline font-semibold text-zinc-900 hover:!text-accent dark:text-zinc-100"
                >
                  {author.name}
                </a>
                <p class="text-xs text-zinc-500 dark:text-white">{author.role}</p>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-200">
              {author.name.split(' ')[0]} writes for UpNorthHub on {CATEGORY_LABELS[category].toLowerCase()},
              blending field-tested practice with sharp editorial.
            </p>
          </div>

          <!-- Related -->
          {
            related.length > 0 && (
              <div class="rounded-xl border border-zinc-200 bg-zinc-100 p-5 dark:border-zinc-800 dark:bg-zinc-900/30">
                <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Related</h2>
                <ul class="mt-3 space-y-4">
                  {related.map((r) => (
                    <li>
                      <a href={`/posts/${r.slug}/`} class="group block">
                        <span class="text-[11px] uppercase tracking-wider text-zinc-500 dark:text-zinc-300">{CATEGORY_LABELS[r.data.category]}</span>
                        <p class="mt-0.5 text-sm font-medium leading-snug text-zinc-700 group-hover:text-accent dark:text-zinc-300">
                          {r.data.title}
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <!-- Related grid -->
    {
      related.length > 0 && (
        <section class="mt-16 border-t border-zinc-200 pt-10 lg:mt-24 dark:border-zinc-800">
          <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white">Keep reading</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => <PostCard post={r} showExcerpt={false} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  // Smooth-scroll TOC links and set active state on scroll.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
  );
  const map = new Map<string, HTMLAnchorElement>();
  links.forEach((l) => map.set(l.getAttribute('data-toc-link')!, l));

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('data-toc-link');
      const el = id ? document.getElementById(id) : null;
      if (el) {
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      }
    });
  });

  if ('IntersectionObserver' in window && map.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
         entries.forEach((entry) => {
           if (entry.isIntersecting) {
             links.forEach((l) => l.classList.remove('text-zinc-900', 'dark:text-white'));
             map.get(entry.target.id)?.classList.add('text-zinc-900', 'dark:text-white');
           }
         });
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 1 }
    );
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // Copy link button.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-copy-link') ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => (copyBtn.textContent = original), 1500);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>
