---
/**
 * category/[category].astro — Category feed, page 1.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_ORDER, CATEGORY_LABELS, CATEGORY_DESCRIPTIONS } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  return CATEGORY_ORDER.map((cat) => ({
    params: { category: cat },
    props: {
      category: cat,
      posts: posts
        .filter((p) => p.data.category === cat)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const { posts } = Astro.props;
const total = posts.length;
const SHOW = 9;
const page1 = posts.slice(0, SHOW);
const totalPages = Math.ceil(total / SHOW);
---

<BaseLayout
  title={CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS]}
  description={CATEGORY_DESCRIPTIONS[category as keyof typeof CATEGORY_DESCRIPTIONS]}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS], url: `/category/${category}` }]}
>
  <div class="container-editorial py-12 lg:py-16">
    <header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <span class="badge badge-accent">{total} articles</span>
      <h1 class="mt-4 font-serif text-4xl font-black text-zinc-900 sm:text-5xl dark:text-white">
        {CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS]}
      </h1>
      <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-200">{CATEGORY_DESCRIPTIONS[category as keyof typeof CATEGORY_DESCRIPTIONS]}</p>
    </header>

    {
      page1.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {page1.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="mt-10 text-zinc-500">No articles published in this section yet.</p>
      )
    }

    {totalPages > 1 && (
      <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
        <span class="badge badge-accent">1</span>
        <a href={`/category/${category}/2`} class="badge hover:border-accent hover:text-accent">Next →</a>
      </nav>
    )}
  </div>
</BaseLayout>
