---
/**
 * privacy.astro — Privacy policy page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="UpNorthHub privacy policy"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Privacy', url: '/privacy' },
  ]}
>
  <div class="container-editorial py-12 lg:py-16">
    <header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <span class="badge badge-accent">Privacy Policy</span>
      <h1 class="mt-4 font-serif text-4xl font-black text-zinc-900 dark:text-white sm:text-5xl">
        Privacy Policy
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
        UpNorthHub does not collect personal data from visitors. All articles are
        publicly accessible without requiring account creation or login.
      </p>
    </header>

    <div class="mt-10 space-y-8 lg:mt-14">
      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Information We Collect</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
          UpNorthHub does not collect personal data from visitors. All articles are
          publicly accessible without requiring account creation or login.
        </p>
      </section>

      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Cookies</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
          We use essential cookies only to enable site functionality (theme toggle,
          search modal). We do not use analytics tracking cookies beyond the Google
          Analytics 4 property installed site-wide (ID: G-QF2R8NK5RF). You can
          disable cookies in your browser settings.
        </p>
      </section>

      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Google Analytics</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
          This site uses Google Analytics 4 (GA4) with property ID <code>G-QF2R8NK5RF</code>
          to measure audience behavior. GA4 collects IP address (anonymized), page
          views, referral sources, and browser/device information. No personally
          identifiable information is collected. You can opt-out of GA4 via
          <a href="https://tools.google.com/dl/gaoptout" target="_blank" rel="noopener noreferrer" class="link-underline hover:!text-accent">Google's opt-out page</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent">External Links and Services</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
          The site contains links to third-party websites (Pixabay for images,
          Google Analytics, and referenced tools/platforms). We are not responsible
          for the privacy practices or content of such sites. Users should review
          the privacy policies of all third-party services they interact with.
        </p>
      </section>

      <section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent">Changes to This Policy</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
          We may update this privacy policy from time to time. We encourage users
          to review this page periodically for any changes. We will post any
          changes here with an updated "Last updated" date.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>