---
/**
 * tags.astro — All tags index.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="All Tags"
  description="Browse every topic tag across the UpNorthHub archive."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tags', url: '/tags' }]}
>
  <div class="container-editorial py-12 lg:py-16">
    <header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <h1 class="font-serif text-4xl font-black text-zinc-900 sm:text-5xl dark:text-white">Tags</h1>
      <p class="mt-3 text-zinc-600 dark:text-zinc-200">Jump straight to a topic across the archive.</p>
    </header>
    <div class="mt-10 flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
            class="badge text-sm hover:border-accent hover:text-accent"
          >
            #{tag} <span class="text-zinc-500">({count})</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
