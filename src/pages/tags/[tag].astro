---
/**
 * tags/[tag].astro — Tag archive, page 1.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  const tagSet = new Map<string, (typeof posts)[number][]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase();
      if (!tagSet.has(key)) tagSet.set(key, []);
      tagSet.get(key)!.push(post);
    }
  }
  return Array.from(tagSet.entries()).map(([tag, tagged]) => {
    const sorted = tagged.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag },
      props: {
        tagLabel: sorted[0].data.tags.find((t) => t.toLowerCase() === tag) ?? tag,
        posts: sorted,
      },
    };
  });
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { tagLabel, posts } = Astro.props;
const total = posts.length;
const SHOW = 9;
const page1 = posts.slice(0, SHOW);
const totalPages = Math.ceil(total / SHOW);
---

<BaseLayout
  title={`#${tagLabel}`}
  description={`Articles tagged ${tagLabel} on UpNorthHub.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tags', url: '/tags' }, { name: `#${tagLabel}`, url: `/tags/${tag}` }]}
>
  <div class="container-editorial py-12 lg:py-16">
    <header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Tag archive</span>
      <h1 class="mt-4 font-serif text-4xl font-black text-zinc-900 sm:text-5xl dark:text-white">#{tagLabel}</h1>
      <p class="mt-3 text-zinc-600 dark:text-zinc-200">{total} article{total === 1 ? '' : 's'} tagged with "{tagLabel}".</p>
    </header>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {page1.map((post) => <PostCard post={post} />)}
    </div>

    {totalPages > 1 && (
      <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
        <span class="badge badge-accent">1</span>
        <a href={`/tags/${tag}/2`} class="badge hover:border-accent hover:text-accent">Next →</a>
      </nav>
    )}
  </div>
</BaseLayout>
