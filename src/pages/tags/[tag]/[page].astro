---
/**
 * tags/[tag]/[page].astro — Tag archive, page 2+.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  const tagSet = new Map<string, (typeof posts)[number][]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase();
      if (!tagSet.has(key)) tagSet.set(key, []);
      tagSet.get(key)!.push(post);
    }
  }

  const routes: any[] = [];
  for (const [tag, tagged] of tagSet.entries()) {
    const sorted = tagged.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    const tagLabel = sorted[0].data.tags.find((t) => t.toLowerCase() === tag) ?? tag;
    const totalPages = Math.ceil(sorted.length / 9);
    for (let p = 2; p <= totalPages; p++) {
      const start = (p - 1) * 9;
      routes.push({
        params: { tag, page: String(p) },
        props: {
          tagLabel,
          posts: sorted.slice(start, start + 9),
          currentPage: p,
          totalPages,
          totalItems: sorted.length,
        },
      });
    }
  }
  return routes;
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { tagLabel, posts, currentPage, totalPages, totalItems } = Astro.props;
---

<BaseLayout
  title={`#${tagLabel} — Page ${currentPage}`}
  description={`Articles tagged ${tagLabel} on UpNorthHub.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Tags', url: '/tags' }, { name: `#${tagLabel}`, url: `/tags/${tag}` }]}
>
  <div class="container-editorial py-12 lg:py-16">
    <header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Tag archive</span>
      <h1 class="mt-4 font-serif text-4xl font-black text-zinc-900 sm:text-5xl dark:text-white">#{tagLabel}</h1>
      <p class="mt-3 text-zinc-600 dark:text-zinc-200">{totalItems} article{totalItems === 1 ? '' : 's'} tagged with "{tagLabel}".</p>
    </header>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/tags/${tag}`} />
  </div>
</BaseLayout>
